<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - AjaxSergey</title>
  <script type="importmap"></script>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

<header class="site-header">
  <div class="header-container">
    <a class="site-logo" asp-page="/Index">
      College<span>Job</span>
    </a>
    <nav class ="site-nav">
      <a asp-page="/Index">Главная</a>
      <a asp-page="/Resumes">Каталог резюме</a>
      <a asp-page="/CreateResume">Создать резюме</a>
      <a asp-page="/About">О проекте</a>
    </nav>
  </div>

</header>

<div class="container">
  <main role="main" class="pb-3">
    @RenderBody()
  </main>
</div>

<footer class="site-footer">
  <div class="footer-container">
    <a class="footer-logo" asp-page="/Index">
      College<span>Job</span>
    </a>
    <p>Платформа для старта профессиональной карьеры</p>
    <span class="footer-copy">
      © @DateTime.Now.Year CollegeJob
    </span>
  </div>
</footer>

<script type="module" src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
